#!/usr/bin/env python3
"""devteam: start a director-led team of coding agents for a project in herdr or Orca.

  devteam up [path] [--new] [--backend B]  scaffold .devteam/, start the director, the heartbeat, and hearth when configured
  devteam down [path] [--force]            stop the team, remove its worktrees, close its panes
  devteam status [path]                    show the director, the roster and task counts

Agent commands, run from the project or any of its worktrees:

  devteam hire <name> <role> [--task ID]   start a worker, in a worktree on devteam/<ID> when the role uses one,
                                           or detached at that branch's head when another worktree has it
  devteam prompt <name> <text>             submit a prompt to an agent without waiting for its turn
  devteam key <name> <key>...              press keys in an agent's terminal: enter, up, down, esc
  devteam read <name> [--lines N]          print an agent's recent terminal output
  devteam list                             print each agent's role, task, status and worktree
  devteam fire <name> [--force] [--keep-worktree]
                                           exit an agent, close its pane, remove its worktree unless kept
  devteam clean <ID> [--force]             remove the kept worktree and the merged branch devteam/<ID>
"""

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

BLUEPRINT = Path(__file__).resolve().parent.parent
HEARTH_DIR = Path(os.environ.get("HEARTH_DIR", "~/workspace/hearth")).expanduser()
HEARTH_ENV = ("HEARTH_URL", "HEARTH_TOKEN", "HEARTH_HUMAN")
NAME = re.compile(r"[a-z][a-z0-9_-]{0,31}")
START_MS = 120000

SCAFFOLD = {
    ".gitignore": "session.json\n",
    "vision.md": "# Vision\n\n## Goals\n\n## Non-goals\n\n## Constraints\n\n## Decisions\n",
    "context.md": "# Context\n\n## Checks\n\n## Definition of done\n\n## Known flaky\n\n## Conventions\n",
    "state.md": "# Director state\n",
    "retro.md": "# Retro\n",
    "team.md": "# Team\n\n| Agent | Role | Worktree | Task | Status |\n|---|---|---|---|---|\n",
    "questions.md": "# Questions\n",
    "log.md": "# Log\n",
    "tasks/.gitkeep": "",
}


def die(msg):
    print(f"devteam: {msg}", file=sys.stderr)
    sys.exit(1)


def run(*cmd, cwd=None, check=True):
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    if check and p.returncode:
        die(f"{' '.join(cmd[:3])} failed: {(p.stderr or p.stdout).strip()}")
    return p


def call(tool, *args, check=True):
    """Run a herdr or orca command and return its parsed result, or the error object when check is False."""
    p = run(tool, *args, *(["--json"] if tool == "orca" else []), check=False)
    try:
        out = json.loads(p.stdout or p.stderr)
    except json.JSONDecodeError:
        out = {}
    # Orca exits non-zero for some successful replies, such as an unsatisfied wait, so its ok field decides.
    if (not out["ok"]) if "ok" in out else p.returncode:
        err = out.get("error") or {"code": "unknown", "message": (p.stderr or p.stdout).strip()}
        if check:
            die(f"{tool} {args[0]} {args[1]}: {err['message']}")
        return {"error": err}
    return out.get("result", {})


class Herdr:
    """Agents are herdr agents addressed by name. The director gets its own herdr workspace."""

    name = "herdr"

    def open(self, repo, label, env):
        ws = call("herdr", "workspace", "create", "--cwd", str(repo), "--label", label, *env, "--no-focus")
        return {"workspace": ws["workspace"]["workspace_id"]}, ws["root_pane"]["pane_id"]

    def place(self, repo, session, branch, base=None):
        """Return (pane, worktree path) for a new agent, in a new worktree on branch when one is given, from base if given."""
        if branch:
            wt = call("herdr", "worktree", "create", "--cwd", str(repo), "--branch", branch, *(["--base", base] if base else []),
                      "--label", branch, "--no-focus")
            return wt["root_pane"]["pane_id"], wt["workspace"]["worktree"]["checkout_path"]
        p = call("herdr", "pane", "split", "--pane", session["agents"][session["director"]]["pane"],
                 "--direction", "down", "--cwd", str(repo), "--no-focus")
        return p["pane"]["pane_id"], None

    def start(self, name, kind, args, pane, cwd):
        r = call("herdr", "agent", "start", name, "--kind", kind, "--pane", pane, "--timeout", str(START_MS),
                 "--", *args, check=False)
        if "error" in r and r["error"]["code"] not in ("agent_not_ready", "timeout"):
            die(f"{name} did not start: {r['error']['message']}")
        return name

    def wait(self, ref, timeout_ms):
        return "error" not in call("herdr", "agent", "wait", ref, "--until", "idle", "--timeout", str(timeout_ms), check=False)

    def status(self, ref):
        r = call("herdr", "agent", "get", ref, check=False)
        return "gone" if "error" in r else r["agent"]["agent_status"]

    def prompt(self, ref, text):
        call("herdr", "agent", "prompt", ref, text)

    def prompt_started(self, ref, text):
        """Submit a prompt and report whether the agent started on it."""
        r = call("herdr", "agent", "prompt", ref, text, "--wait", *[a for s in ("working", "blocked", "idle", "done")
                                                                    for a in ("--until", s)], "--timeout", "15000", check=False)
        return r.get("error", {}).get("code") != "agent_prompt_stalled"

    def run_beside(self, session, cwd, command, env, title):
        """Run a command in a new pane below the hearth runner, or beside the director without one, and return the pane."""
        beside = session.get("runner_pane") or session["agents"][session["director"]]["pane"]
        p = call("herdr", "pane", "split", "--pane", beside, "--direction", "down", "--cwd", str(cwd),
                 *env, "--no-focus")["pane"]["pane_id"]
        call("herdr", "pane", "run", p, command)
        return p

    def keys(self, ref, keys):
        call("herdr", "agent", "send-keys", ref, *keys)

    def read(self, ref, lines):
        p = run("herdr", "agent", "read", ref, "--source", "recent-unwrapped", "--lines", str(lines), check=False)
        if p.returncode and "agent_not_idle" in p.stderr + p.stdout:
            # herdr can capture history only while the agent is idle. A working agent gives its visible screen.
            p = run("herdr", "agent", "read", ref, "--source", "visible")
        elif p.returncode:
            die(f"herdr agent read failed: {(p.stderr or p.stdout).strip()}")
        return p.stdout

    def close(self, agent):
        # A worktree agent is the only pane in its workspace. Closing it would close the workspace before
        # remove_worktree can find it, so removing the worktree closes the pane instead.
        if not agent["worktree"]:
            call("herdr", "pane", "close", agent["pane"], check=False)

    def remove_worktree(self, repo, path, force):
        for wt in call("herdr", "worktree", "list", "--cwd", str(repo))["worktrees"]:
            if wt["path"] == path and wt.get("open_workspace_id"):
                r = call("herdr", "worktree", "remove", "--workspace", wt["open_workspace_id"], *(["--force"] if force else []),
                         check=False)
                return r["error"]["message"] if "error" in r else None
        p = run("git", "worktree", "remove", *(["--force"] if force else []), path, cwd=repo, check=False)
        return (p.stderr or p.stdout).strip() if p.returncode else None

    def shut(self, session):
        r = call("herdr", "workspace", "close", session["workspace"], check=False)
        if "error" in r and r["error"]["code"] != "workspace_not_found":
            return f"workspace {session['workspace']}: {r['error']['message']}"


class Orca:
    """Agents are Orca terminals addressed by handle. The director gets a terminal in the repo's Orca worktree."""

    name = "orca"
    KEYS = {"up": "\x1b[A", "down": "\x1b[B", "esc": "\x1b"}

    def open(self, repo, label, env):
        if "error" in call("orca", "worktree", "show", "--worktree", f"path:{repo}", check=False):
            call("orca", "repo", "add", "--path", str(repo))
        return {}, None

    def place(self, repo, session, branch, base=None):
        if not branch:
            return None, None
        wt = call("orca", "worktree", "create", "--repo", f"path:{repo}", "--name", branch, *(["--base-branch", base] if base else []),
                  "--setup", "skip")["worktree"]
        # Orca names the branch after the worktree with a user prefix. Workers and merges expect devteam/<task-id>.
        run("git", "-C", wt["path"], "branch", "-m", branch)
        return None, wt["path"]

    def start(self, name, kind, args, pane, cwd):
        t = call("orca", "terminal", "create", "--worktree", f"path:{cwd}", "--title", name,
                 "--command", shlex.join([kind, *args]))
        return t["terminal"]["handle"]

    def _wait(self, ref, timeout_ms):
        return call("orca", "terminal", "wait", "--terminal", ref, "--for", "tui-idle", "--timeout-ms", str(timeout_ms),
                    check=False)

    def wait(self, ref, timeout_ms):
        # Orca returns at once while the agent shows a dialog, so poll until it is idle or time runs out.
        end = time.monotonic() + timeout_ms / 1000
        while (left := int((end - time.monotonic()) * 1000)) > 0:
            r = self._wait(ref, left)
            if "error" in r or r["wait"]["status"] != "running":
                return False
            if r["wait"]["satisfied"]:
                return True
            time.sleep(2)
        return False

    def status(self, ref):
        r = self._wait(ref, 3000)
        if "error" in r:
            return "working" if r["error"]["code"] == "timeout" else "gone"
        w = r["wait"]
        if w["status"] != "running":
            return "exited"
        if w.get("blockedReason"):
            return f"blocked ({w['blockedReason']})"
        return "idle" if w["satisfied"] else "working"

    def prompt(self, ref, text):
        call("orca", "terminal", "send", "--terminal", ref, "--text", text, "--enter")

    def prompt_started(self, ref, text):
        r = call("orca", "terminal", "send", "--terminal", ref, "--text", text, "--enter", "--wait-submit", "15", check=False)
        return "turn_started" in json.dumps(r)

    def run_beside(self, session, cwd, command, env, title):
        return call("orca", "terminal", "create", "--worktree", f"path:{cwd}", "--title", title,
                    "--command", command)["terminal"]["handle"]

    def keys(self, ref, keys):
        for k in keys:
            if k == "enter":
                call("orca", "terminal", "send", "--terminal", ref, "--enter")
            elif k in self.KEYS:
                call("orca", "terminal", "send", "--terminal", ref, "--text", self.KEYS[k])
            else:
                die(f"unknown key {k}. Use enter, up, down or esc.")

    def read(self, ref, lines):
        return "\n".join(call("orca", "terminal", "read", "--terminal", ref, "--limit", str(lines))["terminal"]["tail"]) + "\n"

    def close(self, agent):
        call("orca", "terminal", "close", "--terminal", agent["ref"], check=False)

    def remove_worktree(self, repo, path, force):
        r = call("orca", "worktree", "rm", "--worktree", f"path:{path}", *(["--force"] if force else []), check=False)
        return r["error"]["message"] if "error" in r else None

    def shut(self, session):
        if session.get("heartbeat"):
            call("orca", "terminal", "close", "--terminal", session["heartbeat"], check=False)


BACKENDS = {"herdr": Herdr, "orca": Orca}


def detect_backend():
    """Prefer the multiplexer this shell runs in, then whichever one is installed."""
    if os.environ.get("ORCA_TERMINAL_HANDLE"):
        return "orca"
    if os.environ.get("HERDR_ENV"):
        return "herdr"
    for b in ("herdr", "orca"):
        if shutil.which(b):
            return b
    die("missing: herdr or orca")


def role_settings(f):
    """TOML frontmatter between +++ lines at the top of a role file, or {}."""
    m = re.match(r"\+\+\+\n(.*?)\n\+\+\+\n", f.read_text(), re.S)
    return tomllib.loads(m.group(1)) if m else {}


def use_hearth():
    """Hearth is on when any HEARTH_ variable is set, so a partial setup fails loudly instead of being ignored."""
    return any(os.environ.get(v) for v in HEARTH_ENV)


def check_tools(backend, hearth):
    missing = [t for t in (backend, "git", *(["node"] if hearth else [])) if not shutil.which(t)]
    if hearth:
        missing += [v for v in HEARTH_ENV if not os.environ.get(v)]
        files = ("runner/index.ts", "mcp/index.ts") if backend == "herdr" else ("mcp/index.ts",)
        for f in files:
            if not (HEARTH_DIR / f).is_file():
                missing.append(f"{HEARTH_DIR}/{f} (set HEARTH_DIR)")
    if missing:
        die("missing: " + ", ".join(missing))


def load_project(dt):
    """The project's team settings and role settings. The blueprint is not read after scaffolding."""
    cfg = tomllib.loads((dt / "team.toml").read_text())
    roles = {f.stem: role_settings(f) for f in sorted((dt / "roles").glob("*.md"))}
    director = roles.get(cfg["director"])
    if director is None:
        die(f"no director role at {dt}/roles/{cfg['director']}.md")
    if director.get("kind") != "claude":
        die(f"director kind must be claude, got {director.get('kind')}. Codex drops its current turn when a worker reports.")
    missing = sorted({r["kind"] for r in roles.values() if r.get("kind") and not shutil.which(r["kind"])})
    if missing:
        die("missing agent CLIs: " + ", ".join(missing))
    return cfg, roles


def slug(repo):
    s = re.sub(r"[^a-z0-9-]+", "-", repo.name.lower()).strip("-")
    if not s or not s[0].isalpha():
        s = "p-" + s
    return s[:16].rstrip("-")


def agent_args(role):
    args = []
    if role.get("model"):
        args += ["--model" if role["kind"] == "claude" else "-m", role["model"]]
    return args + role.get("args", [])


def repo_root(path, new):
    repo = Path(path or ".").expanduser().resolve()
    if new:
        if repo.exists() and any(repo.iterdir()):
            die(f"{repo} exists and is not empty")
        repo.mkdir(parents=True, exist_ok=True)
        run("git", "init", "-q", cwd=repo)
        shutil.copy(BLUEPRINT / "templates/AGENTS.md", repo / "AGENTS.md")
        run("git", "add", "AGENTS.md", cwd=repo)
        run("git", "commit", "-q", "-m", "Initial commit", cwd=repo)
        return repo
    # The common git dir belongs to the main checkout, so this also works from a worker's worktree.
    p = run("git", "rev-parse", "--path-format=absolute", "--git-common-dir", cwd=repo, check=False)
    if p.returncode:
        die(f"{repo} is not a git repo. Use --new to create a project.")
    repo = Path(p.stdout.strip()).parent
    if run("git", "rev-parse", "--verify", "-q", "HEAD", cwd=repo, check=False).returncode:
        die(f"{repo} has no commits. Worktrees need at least one.")
    return repo


def load_session(repo):
    sf = repo / ".devteam/session.json"
    if not sf.exists():
        die(f"no team is running for {repo}")
    session = json.loads(sf.read_text())
    if "backend" not in session:
        # Written by the herdr-only devteam, which recorded only the director and its panes.
        session = {"backend": "herdr", "workspace": session["workspace"], "runner_pane": session.get("runner_pane"),
                   "heartbeat": session.get("heartbeat_pane"), "director": session["director"],
                   "agents": {session["director"]: {"role": "director", "kind": "claude", "exit": "/exit",
                                                    "ref": session["director"], "pane": session["director_pane"],
                                                    "worktree": None, "task": None}}}
    return session, BACKENDS[session["backend"]]()


def save_session(repo, session):
    sf = repo / ".devteam/session.json"
    tmp = sf.with_suffix(".tmp")
    tmp.write_text(json.dumps(session, indent=2) + "\n")
    tmp.replace(sf)


def agent(session, name):
    if name not in session["agents"]:
        die(f"no agent named {name}. Known: {', '.join(session['agents'])}")
    return session["agents"][name]


def cmd_up(path, new, backend_name):
    backend_name = backend_name or detect_backend()
    hearth = use_hearth()
    check_tools(backend_name, hearth)
    repo = repo_root(path, new)
    prefix = slug(repo) + "-"
    name = prefix + "director"
    dt = repo / ".devteam"
    if (dt / "session.json").exists():
        session, b = load_session(repo)
        if b.status(session["agents"][session["director"]]["ref"]) not in ("gone", "exited"):
            cmd_status(str(repo))
            return
        die(f"a stale team session exists for {repo}. Run devteam down first.")

    for rel, text in SCAFFOLD.items():
        f = dt / rel
        f.parent.mkdir(parents=True, exist_ok=True)
        if not f.exists():
            f.write_text(text)
    # The project gets its own copy of the settings and roles, so nothing points back at the blueprint.
    if not (dt / "team.toml").exists():
        shutil.copy(BLUEPRINT / "team.toml", dt / "team.toml")
    (dt / "roles").mkdir(exist_ok=True)
    for f in (BLUEPRINT / "roles").glob("*.md"):
        if not (dt / "roles" / f.name).exists():
            shutil.copy(f, dt / "roles" / f.name)
    cfg, roles = load_project(dt)

    b = BACKENDS[backend_name]()
    env = [a for v in ("HEARTH_URL", "HEARTH_TOKEN") for a in ("--env", f"{v}={os.environ[v]}")] if hearth else []
    session, pane = b.open(repo, f"devteam: {prefix[:-1]}", env)
    session.update(backend=b.name, director=name, agents={})
    args = agent_args(roles[cfg["director"]])
    if hearth:
        mcp_env = {v: os.environ[v] for v in ("HEARTH_URL", "HEARTH_TOKEN")}
        args += ["--mcp-config", json.dumps({"mcpServers": {"hearth": {
            "command": "node", "args": [str(HEARTH_DIR / "mcp/index.ts")], "env": mcp_env}}})]
    role = roles[cfg["director"]]
    ref = b.start(name, role["kind"], args, pane, repo)
    session["agents"][name] = {"role": cfg["director"], "kind": role["kind"], "exit": role.get("exit"), "ref": ref,
                               "pane": pane, "worktree": None, "task": None}
    save_session(repo, session)
    if not b.wait(ref, START_MS):
        print(f"The director is waiting on a startup dialog. Answer it in its {b.name} terminal. Waiting up to 5 minutes.")
        if not b.wait(ref, 300000):
            die("director never became ready. Check its terminal, then run devteam down and devteam up again.")

    if hearth and b.name == "herdr":
        runner = call("herdr", "pane", "split", "--pane", pane, "--direction", "right", "--ratio", "0.75",
                      "--cwd", str(HEARTH_DIR), *env, "--env", f"RUNNER_HERDR_AGENT={name}", "--env",
                      "RUNNER_TRIGGER=owner", "--no-focus")
        session["runner_pane"] = runner["pane"]["pane_id"]
        call("herdr", "pane", "run", session["runner_pane"], "node runner/index.ts")
    beat = shlex.join([str(Path(__file__).resolve()), "heartbeat", "--minutes", str(cfg.get("heartbeat_minutes", 10))])
    session["heartbeat"] = b.run_beside(session, repo, beat, env, prefix + "heartbeat")
    save_session(repo, session)

    kickoff = "\n".join([
        "You are the director of the dev team for this project.",
        f"Read your role file and follow it: {dt}/roles/{cfg['director']}.md",
        f"Team settings: {dt}/team.toml. Roles: {dt}/roles/",
        f"Devteam CLI: {Path(__file__).resolve()}",
        f"Project: {repo} ({'new project' if new else 'existing repo'})",
        f"Your agent name: {name}. Worker name prefix: {prefix}",
        f"The human on hearth: @{os.environ['HEARTH_HUMAN']}" if hearth else
        "No hearth from devteam: unless your role file says how to reach the human, talk to them in this terminal."
        " They read it and answer by typing to you.",
        "Start now.",
    ])
    # A prompt sent right after a startup dialog closes can be dropped, so resend until the director starts on it.
    for _ in range(3):
        if b.prompt_started(ref, kickoff):
            break
        time.sleep(3)
    else:
        die(f"the director never picked up its kickoff. Check its {b.name} terminal, then run devteam down and up.")
    print(f"director {name} started in {b.name}, heartbeat every {cfg.get('heartbeat_minutes', 10)} minutes")
    if not hearth:
        print("no hearth: the director asks its questions in its own terminal. Answer there.")
    elif b.name == "herdr":
        print(f"hearth runner in {session['runner_pane']}")
    else:
        print("no hearth runner: it supports herdr only, so hearth DMs reach the director only when it wakes")


def submit(b, ref, text):
    """Submit a prompt. A long prompt can sit pasted in the input box, so press Enter once if no turn started."""
    if not b.prompt_started(ref, text):
        b.keys(ref, ["enter"])


def task_worktrees(repo, task):
    """Paths of the worktrees on branch devteam/<task>."""
    p = run("git", "worktree", "list", "--porcelain", cwd=repo)
    return [wt["worktree"] for block in p.stdout.split("\n\n")
            if (wt := dict(line.split(" ", 1) for line in block.splitlines() if " " in line)).get("branch") == f"refs/heads/devteam/{task}"]


def remove_agent(repo, session, b, name, force, keep=False):
    """Exit an agent, close its pane and remove its worktree unless kept. Return an error message or None."""
    a = session["agents"][name]
    if b.status(a["ref"]) not in ("gone", "exited") and a.get("exit"):
        b.prompt(a["ref"], a["exit"])
        b.wait(a["ref"], 5000)
    # herdr closes a worktree agent's pane only with its worktree, so a kept worktree keeps its pane.
    b.close(a)
    err = b.remove_worktree(repo, a["worktree"], force) if a["worktree"] and not keep else None
    if err:
        return f"{a['worktree']}: {err}"
    if keep and a["worktree"]:
        session.setdefault("kept", {})[a["task"]] = {"role": a["role"], "worktree": a["worktree"], "pane": a["pane"]}
    del session["agents"][name]
    save_session(repo, session)


def cmd_down(path, force):
    repo = repo_root(path, False)
    session, b = load_session(repo)
    failed = [e for n in list(session["agents"]) if (e := remove_agent(repo, session, b, n, force))]

    # Catch devteam worktrees whose agent was never recorded, such as after a hire that failed midway.
    p = run("git", "worktree", "list", "--porcelain", cwd=repo)
    for block in p.stdout.split("\n\n"):
        wt = dict(line.split(" ", 1) for line in block.splitlines() if " " in line)
        if not wt.get("branch", "").startswith("refs/heads/devteam/") or any(e.startswith(wt["worktree"] + ":") for e in failed):
            continue
        if err := b.remove_worktree(repo, wt["worktree"], force):
            failed.append(f"{wt['worktree']}: {err}")
    if err := b.shut(session):
        failed.append(err)

    (repo / ".devteam/session.json").unlink()
    (repo / ".devteam/team.md").write_text(SCAFFOLD["team.md"])
    if failed:
        print("not removed:\n  " + "\n  ".join(failed), file=sys.stderr)
        if not force:
            print("worktrees with uncommitted changes need devteam down --force, which discards them", file=sys.stderr)
        sys.exit(1)
    print(f"team for {repo} is down. .devteam/tasks and logs kept.")


def cmd_status(path):
    repo = repo_root(path, False)
    dt = repo / ".devteam"
    if not dt.is_dir():
        die(f"{repo} has no .devteam/")
    if (dt / "session.json").exists():
        session, b = load_session(repo)
        print(f"director {session['director']} ({b.name}): {b.status(session['agents'][session['director']]['ref'])}")
    else:
        print("director: not running")
    print((dt / "team.md").read_text().rstrip())
    counts = {}
    for f in sorted((dt / "tasks").glob("*.md")):
        m = re.search(r"^status:\s*(\S+)", f.read_text(), re.M)
        s = m.group(1) if m else "unknown"
        counts[s] = counts.get(s, 0) + 1
    print("\ntasks: " + (", ".join(f"{k} {v}" for k, v in counts.items()) or "none"))
    q = len(re.findall(r"^## q\d+ \(open\)", (dt / "questions.md").read_text(), re.M)) if (dt / "questions.md").exists() else 0
    print(f"open questions: {q}")


def cmd_hire(name, role_name, task):
    repo = repo_root(None, False)
    session, b = load_session(repo)
    if not NAME.fullmatch(name):
        die(f"name {name} must match {NAME.pattern}")
    if name in session["agents"]:
        die(f"{name} already exists")
    cfg, roles = load_project(repo / ".devteam")
    if role_name not in roles:
        die(f"no role {role_name} in {repo}/.devteam/roles/")
    role = roles[role_name]
    if role.get("worktree") and not task:
        die(f"role {role_name} works in a worktree. Pass --task <id>.")
    branch = base = None
    kept = session.get("kept", {}).get(task) if role.get("worktree") else None
    if kept and kept["role"] == role_name:
        # Rework goes back into the worktree the task's builder kept.
        pane, wt = session["kept"].pop(task)["pane"], kept["worktree"]
    else:
        if role.get("worktree"):
            branch = f"devteam/{task}"
            if not run("git", "rev-parse", "--verify", "-q", f"refs/heads/{branch}", cwd=repo, check=False).returncode:
                # A reviewer of a built task works on the builder's branch. Git allows one worktree per branch, so this
                # one starts on a throwaway branch at its head and detaches from it.
                branch, base = f"{branch}-{name}", branch
        pane, wt = b.place(repo, session, branch, base)
    if base:
        run("git", "-C", wt, "checkout", "-q", "--detach")
        run("git", "-C", wt, "branch", "-q", "-D", branch)
    if branch and (setup := cfg.get("setup")):
        p = subprocess.run(setup, shell=True, cwd=wt, capture_output=True, text=True)
        if p.returncode:
            b.remove_worktree(repo, wt, True)
            die(f"setup `{setup}` failed in {wt}, worktree removed:\n{(p.stderr or p.stdout).strip()[-2000:]}")
    ref = b.start(name, role["kind"], agent_args(role), pane, wt or repo)
    session["agents"][name] = {"role": role_name, "kind": role["kind"], "exit": role.get("exit"), "ref": ref, "pane": pane,
                               "worktree": wt, "task": task}
    save_session(repo, session)
    b.wait(ref, START_MS)
    print(f"{name} hired. Status: {b.status(ref)}. Worktree: {wt or 'none'}" + (f", detached at {base}" if base else ""))


def cmd_clean(task, force):
    """Remove the worktree a fired builder kept for its task, and its branch once merged."""
    repo = repo_root(None, False)
    session, b = load_session(repo)
    paths = task_worktrees(repo, task)
    if users := [n for n, a in session["agents"].items() if a["worktree"] in paths]:
        die(f"{', '.join(users)} still works in {paths[0]}. Fire it first.")
    for path in paths:
        if err := b.remove_worktree(repo, path, force):
            die(f"{path}: {err}")
    if session.get("kept", {}).pop(task, None):
        save_session(repo, session)
    if not run("git", "rev-parse", "--verify", "-q", f"refs/heads/devteam/{task}", cwd=repo, check=False).returncode:
        run("git", "branch", "-q", "-d", f"devteam/{task}", cwd=repo)
    print(f"devteam/{task} cleaned")


def cmd_heartbeat(minutes):
    """Wake an idle director every few minutes while it has workers, so it notices stalled workers."""
    repo = repo_root(None, False)
    while True:
        time.sleep(minutes * 60)
        if not (repo / ".devteam/session.json").exists():
            return
        session, b = load_session(repo)
        workers = [n for n in session["agents"] if n != session["director"]]
        if workers and b.status(session["agents"][session["director"]]["ref"]) in ("idle", "done"):
            b.prompt(session["agents"][session["director"]]["ref"], "heartbeat: check every worker for stalls")
            print(time.strftime("%H:%M"), f"woke {session['director']}, {len(workers)} workers", flush=True)


def cmd_list():
    repo = repo_root(None, False)
    session, b = load_session(repo)
    for name, a in session["agents"].items():
        print(f"{name}\trole={a['role']}\ttask={a['task'] or '-'}\tstatus={b.status(a['ref'])}\tworktree={a['worktree'] or '-'}")


def main():
    ap = argparse.ArgumentParser(prog="devteam", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    up = sub.add_parser("up")
    up.add_argument("path", nargs="?")
    up.add_argument("--new", action="store_true", help="create a new git repo at path")
    up.add_argument("--backend", choices=BACKENDS, help="default: the one this shell runs in, else herdr")
    down = sub.add_parser("down")
    down.add_argument("path", nargs="?")
    down.add_argument("--force", action="store_true", help="remove worktrees even with uncommitted changes")
    st = sub.add_parser("status")
    st.add_argument("path", nargs="?")
    hire = sub.add_parser("hire")
    hire.add_argument("name")
    hire.add_argument("role")
    hire.add_argument("--task", help="task id, required for roles that use a worktree")
    pr = sub.add_parser("prompt")
    pr.add_argument("name")
    pr.add_argument("text")
    key = sub.add_parser("key")
    key.add_argument("name")
    key.add_argument("keys", nargs="+")
    rd = sub.add_parser("read")
    rd.add_argument("name")
    rd.add_argument("--lines", type=int, default=120)
    sub.add_parser("list")
    hb = sub.add_parser("heartbeat", help=argparse.SUPPRESS)
    hb.add_argument("--minutes", type=float, default=10)
    fire = sub.add_parser("fire")
    fire.add_argument("name")
    fire.add_argument("--force", action="store_true", help="remove the worktree even with uncommitted changes")
    fire.add_argument("--keep-worktree", action="store_true", help="keep the worktree and branch, for devteam clean after merge")
    cl = sub.add_parser("clean")
    cl.add_argument("task")
    cl.add_argument("--force", action="store_true", help="remove the worktree even with uncommitted changes")
    a = ap.parse_args()
    if a.cmd == "up":
        cmd_up(a.path, a.new, a.backend)
    elif a.cmd == "down":
        cmd_down(a.path, a.force)
    elif a.cmd == "status":
        cmd_status(a.path)
    elif a.cmd == "hire":
        cmd_hire(a.name, a.role, a.task)
    elif a.cmd == "list":
        cmd_list()
    elif a.cmd == "heartbeat":
        cmd_heartbeat(a.minutes)
    elif a.cmd == "clean":
        cmd_clean(a.task, a.force)
    else:
        repo = repo_root(None, False)
        session, b = load_session(repo)
        ref = agent(session, a.name)["ref"]
        if a.cmd == "prompt":
            submit(b, ref, a.text)
        elif a.cmd == "key":
            b.keys(ref, a.keys)
        elif a.cmd == "read":
            sys.stdout.write(b.read(ref, a.lines))
        elif a.cmd == "fire":
            wt = agent(session, a.name)["worktree"]
            if err := remove_agent(repo, session, b, a.name, a.force, a.keep_worktree):
                die(f"{a.name} stopped but its worktree was not removed: {err}")
            print(f"{a.name} fired" + (f". Worktree kept: {wt}" if a.keep_worktree and wt else ""))


if __name__ == "__main__":
    main()
